TIMEZONE=Europe/Stockholm
PUID=1000
PGID=1000

# Homepage substitutes {{HOMEPAGE_VAR_*}} placeholders in config/ from the
# container's environment.
# In practice these are set in Dockhand's per-stack environment store.

# Long-lived access token from Home Assistant (profile -> Security).
# Used by services.yaml for the Home Assistant widget.
HOMEPAGE_VAR_HOMEASSISTANT_API=

# Weather providers declared in settings.yaml. Nothing consumes them until a
# weather widget is added to widgets.yaml, so both can stay blank for now.
HOMEPAGE_VAR_OPENWEATHERMAP_API_KEY=
HOMEPAGE_VAR_WEATHERAPI_API_KEY=
