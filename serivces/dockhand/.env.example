PUID=1000
PGID=1000

# Docker socket group on Core PI, needed for socket access as non-root.
# Find with: stat -c '%g' /var/run/docker.sock
DOCKER_GID=

# Base64 AES-256 key encrypting git credentials, registry passwords and stack
# secrets. On an EXISTING install extract the current key instead of generating
# a new one -- see README "Encryption key". New installs: openssl rand -base64 32
ENCRYPTION_KEY=
