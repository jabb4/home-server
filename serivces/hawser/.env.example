# Dockhand control-plane URL (edge mode, outbound WebSocket).
DOCKHAND_SERVER_URL=wss://dockhand.local.jabbas.dev/api/hawser/connect

# This agent's host. One Hawser runs per managed host, so this is per-deployment.
# Use the same name as the environment in the Dockhand UI, e.g. media-pi
AGENT_NAME=

# Pairing token. Generated in the Dockhand UI when creating the Environment
# (Settings -> Environments -> Add -> Hawser Edge). Shown only once.
HAWSER_TOKEN=
