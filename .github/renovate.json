{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":approveMajorUpdates",
    ":semanticCommitsDisabled",
    ":separateMultipleMajorReleases"
  ],
  "enabledManagers": [
    "docker-compose"
  ],
  "labels": [
    "dependencies"
  ],
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "pinDigests": false,
  "packageRules": [
    {
      "description": "Disable digest-only PRs; we don't pin digests.",
      "matchUpdateTypes": [
        "digest",
        "pinDigest"
      ],
      "enabled": false
    },
    {
      "description": "Tag docker-compose updates so they're easy to scan in the PR list.",
      "matchManagers": [
        "docker-compose"
      ],
      "addLabels": [
        "docker"
      ]
    },
    {
      "description": "Mark major updates explicitly.",
      "matchUpdateTypes": [
        "major"
      ],
      "addLabels": [
        "major"
      ]
    },
    {
      "description": "LSIO images label their own build repo as the source; point changelog lookups at the upstream project instead.",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "lscr.io/linuxserver/jellyfin"
      ],
      "sourceUrl": "https://github.com/jellyfin/jellyfin"
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "lscr.io/linuxserver/sabnzbd"
      ],
      "sourceUrl": "https://github.com/sabnzbd/sabnzbd"
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "lscr.io/linuxserver/bazarr"
      ],
      "sourceUrl": "https://github.com/morpheus65535/bazarr"
    },
    {
      "description": "LSIO truncates these to 3 parts (6.2.1) while upstream tags releases with 4 (v6.2.1.10461), so notes can't be version-matched. Link to the release list instead.",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "lscr.io/linuxserver/radarr"
      ],
      "sourceUrl": "https://github.com/Radarr/Radarr",
      "changelogUrl": "https://github.com/Radarr/Radarr/releases"
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "lscr.io/linuxserver/sonarr"
      ],
      "sourceUrl": "https://github.com/Sonarr/Sonarr",
      "changelogUrl": "https://github.com/Sonarr/Sonarr/releases"
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "lscr.io/linuxserver/prowlarr"
      ],
      "sourceUrl": "https://github.com/Prowlarr/Prowlarr",
      "changelogUrl": "https://github.com/Prowlarr/Prowlarr/releases"
    }
  ],
  "prBodyNotes": [
    "{{#if isMajor}}This is a major update. Read the upstream release notes and migration notes before merging.{{/if}}"
  ]
}
